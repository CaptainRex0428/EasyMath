---
import '../styles/global.css';
const { title = 'EasyMath Demo', back } = Astro.props;
---
<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title} · EasyMath</title>
<slot name="head" />
</head>
<body>
  {back && <div class="topbar">
    <a href={back.href}>← {back.label}</a>
  </div>}
  <slot />
</body>
</html>

<style>
  .topbar {
    padding: 8px 16px;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.8rem;
    background: var(--bg-secondary);
    position: sticky;
    top: 0;
    z-index: 50;
  }
</style>