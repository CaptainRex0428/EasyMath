---
import Layout from '../../layouts/Layout.astro';
import ThemeSwitcher from '../../components/ThemeSwitcher.astro';
---
<Layout title="Matrix Demo">
<div id="app">

  <!-- ===== HEADER ===== -->
  <div id="header">
    <div id="header-left">
      <button id="mobile-menu-btn" class="icon-btn" aria-label="Toggle sidebar">☰</button>
      <span id="header-title">🔢 Matrix Demo</span>
    </div>
    <div id="tab-switcher" role="tablist">
      <button class="tab-btn active" data-tab="webgl" role="tab">
        <span class="tab-icon">⚡</span>
        <span>Pure WebGL</span>
      </button>
      <button class="tab-btn" data-tab="threejs" role="tab">
        <span class="tab-icon">🎲</span>
        <span>Three.js</span>
      </button>
    </div>
    <div id="header-right">
      <ThemeSwitcher />
      <a href="/" id="back-link">← 返回主页</a>
    </div>
  </div>

  <!-- ===== SIDEBAR RESIZER ===== -->
  <div id="sidebar-resizer"></div>

  <!-- ===== CONTROLS SIDEBAR ===== -->
  <div id="controls">

    <!-- Shape selector -->
    <div class="shape-selector">
      <div class="shape-label">Shape</div>
      <div class="shape-btns">
        <button class="shape-btn active" data-shape="cube" title="Cube">
          <span class="shape-btn-icon">⬜</span>
          <span>Cube</span>
        </button>
        <button class="shape-btn" data-shape="sphere" title="Sphere">
          <span class="shape-btn-icon">⚪</span>
          <span>Sphere</span>
        </button>
        <button class="shape-btn" data-shape="cone" title="Cone">
          <span class="shape-btn-icon">🔺</span>
          <span>Cone</span>
        </button>
        <button class="shape-btn" data-shape="torus" title="Torus">
          <span class="shape-btn-icon">⭕</span>
          <span>Torus</span>
        </button>
        <button class="shape-btn" data-shape="cylinder" title="Cylinder">
          <span class="shape-btn-icon">🥫</span>
          <span>Cylinder</span>
        </button>
      </div>
      <button id="view-src-btn" class="src-btn" title="View source code">⟨/⟩ Source</button>
    </div>

    <details class="cs" data-key="model-trans" open>
      <summary><span>Model — 平移 Translation</span><svg class="chev" viewBox="0 0 12 12"><path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg></summary>
      <div class="sc">
        <div class="row">
          <div class="row-header">
            <label>tx</label>
            <span id="tx-v">0.0</span>
          </div>
          <input type="range" id="tx" min="-3" max="3" step="0.1" value="0">
        </div>
        <div class="row">
          <div class="row-header">
            <label>ty</label>
            <span id="ty-v">0.0</span>
          </div>
          <input type="range" id="ty" min="-3" max="3" step="0.1" value="0">
        </div>
        <div class="row">
          <div class="row-header">
            <label>tz</label>
            <span id="tz-v">0.0</span>
          </div>
          <input type="range" id="tz" min="-3" max="3" step="0.1" value="0">
        </div>
      </div>
    </details>

    <details class="cs" data-key="model-rot" open>
      <summary><span>Model — 旋转 Rotation (°)</span><svg class="chev" viewBox="0 0 12 12"><path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg></summary>
      <div class="sc">
        <div class="row">
          <div class="row-header">
            <label>rx</label>
            <span id="rx-v">0°</span>
          </div>
          <input type="range" id="rx" min="0" max="360" step="1" value="0">
        </div>
        <div class="row">
          <div class="row-header">
            <label>ry</label>
            <span id="ry-v">0°</span>
          </div>
          <input type="range" id="ry" min="0" max="360" step="1" value="0">
        </div>
        <div class="row">
          <div class="row-header">
            <label>rz</label>
            <span id="rz-v">0°</span>
          </div>
          <input type="range" id="rz" min="0" max="360" step="1" value="0">
        </div>
      </div>
    </details>

    <details class="cs" data-key="model-scale" open>
      <summary><span>Model — 缩放 Scale</span><svg class="chev" viewBox="0 0 12 12"><path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg></summary>
      <div class="sc">
        <div class="row">
          <div class="row-header">
            <label>sx</label>
            <span id="sx-v">1.0</span>
          </div>
          <input type="range" id="sx" min="0.1" max="3" step="0.05" value="1">
        </div>
        <div class="row">
          <div class="row-header">
            <label>sy</label>
            <span id="sy-v">1.0</span>
          </div>
          <input type="range" id="sy" min="0.1" max="3" step="0.05" value="1">
        </div>
        <div class="row">
          <div class="row-header">
            <label>sz</label>
            <span id="sz-v">1.0</span>
          </div>
          <input type="range" id="sz" min="0.1" max="3" step="0.05" value="1">
        </div>
      </div>
    </details>

    <details class="cs" data-key="camera" open>
      <summary><span>Camera — LookAt 相机</span><svg class="chev" viewBox="0 0 12 12"><path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg></summary>
      <div class="sc">
        <div class="row">
          <div class="row-header">
            <label>ex</label>
            <span id="ex-v">0.0</span>
          </div>
          <input type="range" id="ex" min="-10" max="10" step="0.01" value="0">
        </div>
        <div class="row">
          <div class="row-header">
            <label>ey</label>
            <span id="ey-v">3.0</span>
          </div>
          <input type="range" id="ey" min="-10" max="10" step="0.01" value="3">
        </div>
        <div class="row">
          <div class="row-header">
            <label>ez</label>
            <span id="ez-v">6.0</span>
          </div>
          <input type="range" id="ez" min="-10" max="10" step="0.01" value="6">
        </div>
        <div class="row">
          <div class="row-header">
            <label>ltx</label>
            <span id="ltx-v">0.0</span>
          </div>
          <input type="range" id="ltx" min="-5" max="5" step="0.01" value="0">
        </div>
        <div class="row">
          <div class="row-header">
            <label>lty</label>
            <span id="lty-v">0.0</span>
          </div>
          <input type="range" id="lty" min="-5" max="5" step="0.01" value="0">
        </div>
        <div class="row">
          <div class="row-header">
            <label>ltz</label>
            <span id="ltz-v">0.0</span>
          </div>
          <input type="range" id="ltz" min="-5" max="5" step="0.01" value="0">
        </div>
      </div>
    </details>

    <details class="cs" data-key="projection" open>
      <summary><span>Projection 投影</span><svg class="chev" viewBox="0 0 12 12"><path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg></summary>
      <div class="sc">
        <div class="toggle-row">
          <button class="toggle-btn active" id="btn-persp" onclick="setProj('persp')">Perspective</button>
          <button class="toggle-btn" id="btn-ortho" onclick="setProj('ortho')">Orthographic</button>
        </div>
        <div id="persp-params">
          <div class="row">
            <div class="row-header">
              <label>fov</label>
              <span id="fov-v">60°</span>
            </div>
            <input type="range" id="fov" min="20" max="120" step="1" value="60">
          </div>
        </div>
        <div id="ortho-params" style="display:none">
          <div class="row">
            <div class="row-header">
              <label>size</label>
              <span id="ortho-size-v">4.0</span>
            </div>
            <input type="range" id="ortho-size" min="1" max="10" step="0.1" value="4">
          </div>
        </div>
        <div class="row">
          <div class="row-header">
            <label>near</label>
            <span id="near-v">0.1</span>
          </div>
          <input type="range" id="near" min="0.01" max="2" step="0.01" value="0.1">
        </div>
        <div class="row">
          <div class="row-header">
            <label>far</label>
            <span id="far-v">50.0</span>
          </div>
          <input type="range" id="far" min="10" max="200" step="1" value="50">
        </div>
      </div>
    </details>

  </div><!-- /controls -->

  <!-- ===== CANVAS AREA ===== -->
  <div id="canvas-area">
    <!-- Orbit sensitivity control (top-right corner) -->
    <div id="sensitivity-control">
      <span class="sensitivity-label">Speed</span>
      <input type="range" id="orbit-sensitivity" min="0.1" max="3" step="0.1" value="1">
      <span class="sensitivity-value" id="orbit-sensitivity-v">1.0×</span>
    </div>
    <!-- WebGL tab -->
    <div id="tab-webgl" class="tab-content active">
      <canvas id="gl-canvas"></canvas>
    </div>
    <!-- Three.js tab -->
    <div id="tab-threejs" class="tab-content">
      <div id="threejs-container">
        <div id="threejs-badge">Three.js</div>
      </div>
    </div>
  </div>

  <!-- ===== PIPELINE BAR ===== -->
  <div id="pipeline-bar">
    <div class="ps">Local Space<small>Object Coords</small></div>
    <div class="pa"><span class="arr">→</span><strong>× Model</strong>MTXTranslation·MTXRy·MTXRx·MTXRz·MTXScale</div>
    <div class="ps">World Space<small>World Coords</small></div>
    <div class="pa"><span class="arr">→</span><strong>× MTXLookAt</strong>View Matrix</div>
    <div class="ps">Camera Space<small>View Coords</small></div>
    <div class="pa"><span class="arr">→</span><strong id="proj-fn-label">× MTXPerspective</strong>Proj Matrix</div>
    <div class="ps">Clip Space<small>Homogeneous</small></div>
    <div class="pa"><span class="arr">→</span><strong>÷ w</strong>Perspective Divide</div>
    <div class="ps">NDC<small>[-1,1]³</small></div>
  </div>

  <!-- ===== MATRIX PANEL ===== -->
  <div id="matrix-resize-handle" class="resize-handle-horizontal" role="separator" aria-orientation="horizontal" aria-label="Resize matrix panel"></div>
  <div id="matrix-panel">
    <div class="matrix-pipeline">
      <!-- Model Matrix Card -->
      <div class="matrix-card" data-matrix="model">
        <div class="matrix-card-header">
          <span class="matrix-card-title">Model</span>
          <span class="matrix-card-space">Local → World</span>
        </div>
        <div class="matrix-formula">T · Ry · Rx · Rz · S</div>
        <div class="matrix-values-wrapper">
          <span class="matrix-bracket left">[</span>
          <div class="matrix-grid" id="mat-model"></div>
          <span class="matrix-bracket right">]</span>
        </div>
      </div>

      <!-- Arrow Connector -->
      <div class="matrix-arrow" data-from="model" data-to="view">
        <svg width="40" height="24" viewBox="0 0 40 24" fill="none">
          <path d="M0 12h32M24 4l8 8-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>

      <!-- View Matrix Card -->
      <div class="matrix-card" data-matrix="view">
        <div class="matrix-card-header">
          <span class="matrix-card-title">View</span>
          <span class="matrix-card-space">World → Camera</span>
        </div>
        <div class="matrix-formula">LookAt</div>
        <div class="matrix-values-wrapper">
          <span class="matrix-bracket left">[</span>
          <div class="matrix-grid" id="mat-view"></div>
          <span class="matrix-bracket right">]</span>
        </div>
      </div>

      <!-- Arrow Connector -->
      <div class="matrix-arrow" data-from="view" data-to="projection">
        <svg width="40" height="24" viewBox="0 0 40 24" fill="none">
          <path d="M0 12h32M24 4l8 8-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>

      <!-- Projection Matrix Card -->
      <div class="matrix-card" data-matrix="projection">
        <div class="matrix-card-header">
          <span class="matrix-card-title" id="proj-mat-title">Projection</span>
          <span class="matrix-card-space">Camera → Clip</span>
        </div>
        <div class="matrix-formula">Perspective</div>
        <div class="matrix-values-wrapper">
          <span class="matrix-bracket left">[</span>
          <div class="matrix-grid" id="mat-proj"></div>
          <span class="matrix-bracket right">]</span>
        </div>
      </div>

      <!-- Equals connector (Projection = MVP, semantic result, not a transform) -->
      <div class="matrix-eq" data-from="projection" data-to="mvp">
        <svg width="40" height="24" viewBox="0 0 40 24" fill="none">
          <path d="M4 9h32M4 15h32" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>

      <!-- MVP Matrix Card -->
      <div class="matrix-card" data-matrix="mvp">
        <div class="matrix-card-header">
          <span class="matrix-card-title">MVP</span>
          <span class="matrix-card-space">Local → Clip</span>
        </div>
        <div class="matrix-formula">P · V · M</div>
        <div class="matrix-values-wrapper">
          <span class="matrix-bracket left">[</span>
          <div class="matrix-grid" id="mat-mvp"></div>
          <span class="matrix-bracket right">]</span>
        </div>
      </div>

      <!-- Divide connector — Clip ÷ w = NDC (per-vertex perspective divide) -->
      <div class="matrix-div" data-from="mvp" data-to="ndc">
        <svg width="40" height="24" viewBox="0 0 40 24" fill="none">
          <circle cx="20" cy="6" r="1.5" fill="currentColor"/>
          <path d="M8 12h24" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <circle cx="20" cy="18" r="1.5" fill="currentColor"/>
        </svg>
      </div>

      <!-- NDC Card (not a 4×4 matrix — perspective divide is per-vertex, w varies) -->
      <div class="matrix-card matrix-card-formula" data-matrix="ndc">
        <div class="matrix-card-header">
          <span class="matrix-card-title">NDC</span>
          <span class="matrix-card-space">Clip → Normalized</span>
        </div>
        <div class="matrix-formula">clip.xyz ÷ clip.w</div>
        <div class="ndc-range">ndc ∈ [-1, 1]³</div>
      </div>

      <!-- Arrow connector — NDC → Viewport (viewport transform) -->
      <div class="matrix-arrow" data-from="ndc" data-to="viewport">
        <svg width="40" height="24" viewBox="0 0 40 24" fill="none">
          <path d="M0 12h32M24 4l8 8-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>

      <!-- Viewport Card — NDC [-1,1] → screen pixels [0,w]×[0,h] (structure shown, not values) -->
      <div class="matrix-card matrix-card-formula" data-matrix="viewport">
        <div class="matrix-card-header">
          <span class="matrix-card-title">Viewport</span>
          <span class="matrix-card-space">NDC → Screen</span>
        </div>
        <div class="matrix-formula">(ndc + 1) × size / 2</div>
        <div class="ndc-range" id="viewport-size">canvas: — × —</div>
      </div>
    </div>
  </div>

  <!-- Mobile overlay backdrop -->
  <div id="sidebar-backdrop"></div>

  <!-- Source code modal -->
  <div id="src-modal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-box">
      <div class="modal-header">
        <span id="modal-title">Source Code</span>
        <div class="modal-header-actions">
          <button id="modal-copy-btn" class="modal-action-btn" title="Copy code">⎘ Copy</button>
          <button id="modal-close-btn" class="modal-action-btn" title="Close">✕</button>
        </div>
      </div>
      <div class="modal-tabs">
        <button class="modal-tab active" data-src="geo">Geometry</button>
        <button class="modal-tab" data-src="vert">Vertex Shader</button>
        <button class="modal-tab" data-src="frag">Fragment Shader</button>
      </div>
      <pre id="modal-code" class="modal-code"><code></code></pre>
    </div>
  </div>

</div><!-- /app -->
</Layout>

<style is:global>
/* ===== LAYOUT =====
   Use height:100vh so grid rows with 1fr get real pixel heights.
   body/html overflow is hidden here; only #controls scrolls internally.
===== */
html, body { height: 100%; overflow: hidden; margin: 0; padding: 0; }</style>

<style is:inline>

#app {
  display: grid;
  grid-template-columns: var(--sidebar-width, 280px) 4px 1fr;
  grid-template-rows: var(--header-height) 1fr auto 6px 280px;
  height: 100vh;
  overflow: hidden;
}

/* Header spans full width */
#header {
  grid-column: 1 / -1;
  grid-row: 1;
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: 0 var(--space-lg);
  background: var(--bg-secondary);
  border-bottom: 1px solid var(--border-color);
  z-index: var(--z-header);
  flex-shrink: 0;
}

#header-left { display: flex; align-items: center; gap: var(--space-sm); }
#header-title { font-size: 0.9rem; font-weight: var(--weight-semibold); color: var(--accent-primary); white-space: nowrap; }
#header-right { margin-left: auto; display: flex; align-items: center; gap: var(--space-md); font-size: var(--text-md); }
#back-link { color: var(--text-secondary); }
#back-link:hover { color: var(--text-primary); }

/* Sidebar resizer */
#sidebar-resizer {
  grid-column: 2;
  grid-row: 2 / 6;
  background: transparent;
  cursor: col-resize;
  transition: background var(--transition-fast);
  z-index: var(--z-resizer);
  position: relative;
}
#sidebar-resizer:hover,
#sidebar-resizer.resizing {
  background: var(--accent-primary);
}

/* Controls sidebar — scrolls internally */
#controls {
  grid-column: 1;
  grid-row: 2 / 6;
  background: var(--bg-secondary);
  overflow-y: auto;
  overflow-x: hidden;
  padding: var(--space-lg);
}

/* Canvas area — fills the grid cell, children use absolute/100% */
#canvas-area {
  grid-column: 3;
  grid-row: 2;
  position: relative;
  overflow: hidden;
  background: var(--bg-primary);
}

/* Tab content: use absolute positioning so height is always the parent cell height */
.tab-content {
  display: none;
  position: absolute;
  inset: 0;
}
.tab-content.active { display: block; }

#gl-canvas { display: block; width: 100%; height: 100%; }
#threejs-container { width: 100%; height: 100%; position: relative; }
#threejs-badge {
  position: absolute; top: 8px; right: 10px;
  font-size: 0.7rem; color: var(--text-muted); pointer-events: none;
}

/* Orbit sensitivity control — top-right of canvas, below the badge */
#sensitivity-control {
  position: absolute;
  top: 28px;
  right: 10px;
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 8px;
  background: rgba(0, 0, 0, 0.4);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  font-size: 0.7rem;
  color: var(--text-secondary);
  z-index: var(--z-base);
  backdrop-filter: blur(4px);
}
.sensitivity-label {
  font-weight: var(--weight-medium);
  letter-spacing: 0.04em;
  white-space: nowrap;
}
#sensitivity-control input[type=range] {
  width: 80px;
  height: 4px;
  -webkit-appearance: none;
  appearance: none;
  background: var(--bg-quaternary);
  border-radius: 2px;
  cursor: pointer;
}
#sensitivity-control input[type=range]::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: var(--accent-primary);
  border: 1px solid var(--bg-secondary);
  cursor: pointer;
}
#sensitivity-control input[type=range]::-moz-range-thumb {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: var(--accent-primary);
  border: 1px solid var(--bg-secondary);
  cursor: pointer;
}
.sensitivity-value {
  font-family: var(--font-mono);
  color: var(--accent-primary);
  font-weight: var(--weight-medium);
  min-width: 32px;
  text-align: right;
}

/* Pipeline bar */
#pipeline-bar {
  grid-column: 3;
  grid-row: 3;
  background: #13191f;
  border-top: 1px solid var(--border-color);
  border-bottom: 1px solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-md) var(--space-lg);
  overflow-x: auto;
  gap: var(--space-md);
}
.ps {
  text-align: center;
  font-size: 1rem;
  font-weight: 600;
  padding: 6px 16px;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-color);
  background: var(--bg-secondary);
  white-space: nowrap;
  line-height: 1.4;
}
.ps small {
  font-size: 0.85rem;
  color: var(--accent-blue);
  font-weight: 400;
  display: block;
}
.pa {
  font-size: 1rem;
  text-align: center;
  color: var(--text-secondary);
  padding: 0 var(--space-sm);
  line-height: 1.4;
  white-space: nowrap;
  flex-shrink: 0;
}
.pa strong {
  color: var(--accent-green);
  display: block;
  font-size: 1.1rem;
  font-weight: 700;
}
.pa .arr {
  color: var(--text-muted);
  font-size: 1.2rem;
}

/* ===== MATRIX PANEL ===== */
#matrix-panel {
  grid-column: 3;
  grid-row: 5;
  background: var(--bg-secondary);
  border-top: 1px solid var(--border-color);
  overflow-x: auto;
  overflow-y: hidden;
  height: 100%;
}

/* Resize handle for matrix panel — independent grid row, same style as sidebar resizer */
.resize-handle-horizontal {
  grid-column: 3;
  grid-row: 4;
  background: transparent;
  cursor: ns-resize;
  z-index: var(--z-resizer);
  transition: background var(--transition-fast);
}

.resize-handle-horizontal:hover,
.resize-handle-horizontal.dragging {
  background: var(--accent-primary);
}

/* Matrix pipeline flowchart layout */
.matrix-pipeline {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-md);
  padding: var(--space-xl) var(--space-lg);
  min-width: min-content;
  height: 100%;
}

/* Matrix card */
.matrix-card {
  display: flex;
  flex-direction: column;
