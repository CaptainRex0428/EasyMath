// TAB SWITCHING
// ============================================================
function switchTab(tab) {
  activeTab = tab;
  STORAGE.set('active-tab', tab);
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.toggle('active', b.dataset.tab === tab));
  document.getElementById('tab-webgl').classList.toggle('active', tab === 'webgl');
  document.getElementById('tab-threejs').classList.toggle('active', tab === 'threejs');
  const url = new URL(location.href);
  url.searchParams.set('tab', tab);
  history.replaceState(null, '', url);
}

document.querySelectorAll('.tab-btn').forEach(btn => {
  btn.addEventListener('click', () => switchTab(btn.dataset.tab));
});

switchTab(activeTab);

// ============================================================
// SIDEBAR RESIZE
// ============================================================
(function initResize() {
  const MIN=200, MAX=600, DEFAULT=280;
  let savedWidth = STORAGE.get('sidebar-width', DEFAULT);
  savedWidth = Math.min(Math.max(savedWidth, MIN), MAX);

  function setWidth(w) {
    document.documentElement.style.setProperty('--sidebar-width', w + 'px');
  }
  setWidth(savedWidth);

  const resizer = document.getElementById('sidebar-resizer');
  let isResizing=false, startX=0, startW=0;

  resizer.addEventListener('mousedown', e => {
    isResizing=true; startX=e.clientX;
    startW = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--sidebar-width')) || DEFAULT;
    document.body.style.cursor='col-resize';
    document.body.style.userSelect='none';
    resizer.classList.add('resizing');
    e.preventDefault();
  });
  document.addEventListener('mousemove', e => {
    if(!isResizing) return;
    const w = Math.min(Math.max(startW + (e.clientX - startX), MIN), MAX);
    setWidth(w);
  });
  document.addEventListener('mouseup', () => {
    if(!isResizing) return;
    isResizing=false;
    document.body.style.cursor='';
    document.body.style.userSelect='';
    resizer.classList.remove('resizing');
    const w = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--sidebar-width')) || DEFAULT;
    STORAGE.set('sidebar-width', w);
  });
})();

