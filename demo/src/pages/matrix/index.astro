// ============================================================
// SOURCE CODE VIEWER MODAL
// ============================================================
const SOURCE_GEO = {
  cube: `// Cube — 6 faces × 4 vertices, interleaved x,y,z,r,g,b
// Matches EasyMath C++ mesh convention (row-major, unit cube)
function buildCube() {
  const C = 0.5;
  const verts = new Float32Array([
    // Front  (-z) red
    -C,-C,-C, 0.9,0.3,0.3,   C,-C,-C, 0.9,0.3,0.3,
     C, C,-C, 0.9,0.3,0.3,  -C, C,-C, 0.9,0.3,0.3,
    // Back   (+z) blue
    -C,-C, C, 0.3,0.5,0.9,   C,-C, C, 0.3,0.5,0.9,
     C, C, C, 0.3,0.5,0.9,  -C, C, C, 0.3,0.5,0.9,
    // Left   (-x) green
    -C,-C, C, 0.3,0.85,0.4, -C,-C,-C, 0.3,0.85,0.4,
    -C, C,-C, 0.3,0.85,0.4, -C, C, C, 0.3,0.85,0.4,
    // Right  (+x) orange
     C,-C,-C, 0.95,0.65,0.2, C,-C, C, 0.95,0.65,0.2,
     C, C, C, 0.95,0.65,0.2, C, C,-C, 0.95,0.65,0.2,
    // Top    (+y) cyan
    -C, C,-C, 0.3,0.85,0.85, C, C,-C, 0.3,0.85,0.85,
     C, C, C, 0.3,0.85,0.85,-C, C, C, 0.3,0.85,0.85,
    // Bottom (-y) gray
    -C,-C, C, 0.5,0.5,0.55,  C,-C, C, 0.5,0.5,0.55,
     C,-C,-C, 0.5,0.5,0.55, -C,-C,-C, 0.5,0.5,0.55,
  ]);
  // 6 faces × 2 triangles each
  const indices = new Uint16Array(
    Array.from({length:6}, (_,f) => {
      const b = f*4;
      return [b, b+1, b+2,  b, b+2, b+3];
    }).flat()
  );
  return { verts, indices };
}`,

  sphere: `// Sphere — spherical coordinates UV subdivision
// stacks × slices grid, color bands by latitude
function buildSphere(stacks=20, slices=30) {
  const verts = [], indices = [];
  for (let i = 0; i <= stacks; i++) {
    const phi = Math.PI * i / stacks;
    const sp = Math.sin(phi), cp = Math.cos(phi);
    const t  = i / stacks;
    const r = 0.2+0.5*t, g = 0.6-0.2*t, b = 0.9-0.4*t;
    for (let j = 0; j <= slices; j++) {
      const theta = 2 * Math.PI * j / slices;
      verts.push(
        sp * Math.cos(theta) * 0.7,  // x
        cp * 0.7,                     // y
        sp * Math.sin(theta) * 0.7,  // z
        r, g, b
      );
    }
  }
  for (let i = 0; i < stacks; i++)
    for (let j = 0; j < slices; j++) {
      const a = i*(slices+1)+j, b = a+slices+1;
      indices.push(a, b, a+1,  b, b+1, a+1);
    }
  return { verts: new Float32Array(verts), indices: new Uint16Array(indices) };
}`,

  cone: `// Cone — side triangles (base ring → apex) + base cap
function buildCone(slices=32) {
  const verts = [], indices = [];
  const H = 1.0, R = 0.6;
  // Side: each slice → one triangle (base vertex + apex)
  for (let j = 0; j <= slices; j++) {
    const theta = 2 * Math.PI * j / slices;
    const ct = Math.cos(theta), st = Math.sin(theta);
    const t  = j / slices;
    verts.push(R*ct, -H/2, R*st,  0.95, 0.5+0.3*t, 0.2); // base
    verts.push(0,     H/2, 0,     1.0,  0.8,        0.3); // apex
  }
  for (let j = 0; j < slices; j++)
    indices.push(j*2, j*2+2, j*2+1);
  // Base cap (center + ring)
  const capC = verts.length / 6;
  verts.push(0, -H/2, 0,  0.5, 0.3, 0.1);
  for (let j = 0; j <= slices; j++) {
    const theta = 2 * Math.PI * j / slices;
    verts.push(R*Math.cos(theta), -H/2, R*Math.sin(theta), 0.6,0.35,0.15);
  }
  for (let j = 0; j < slices; j++)
    indices.push(capC, capC+j+2, capC+j+1);
  return { verts: new Float32Array(verts), indices: new Uint16Array(indices) };
}`,

  torus: `// Torus — R = major radius, r = tube radius
// Double UV loop: radial segments × tube segments
function buildTorus(R=0.55, r=0.22, tubeSeg=24, radSeg=36) {
  const verts = [], indices = [];
  for (let i = 0; i <= radSeg; i++) {
    const u  = 2 * Math.PI * i / radSeg;
    const cu = Math.cos(u), su = Math.sin(u);
    const t  = i / radSeg;
    for (let j = 0; j <= tubeSeg; j++) {
      const v  = 2 * Math.PI * j / tubeSeg;
      const cv = Math.cos(v), sv = Math.sin(v);
      verts.push(
        (R + r*cv) * cu,   // x
        r * sv,            // y
        (R + r*cv) * su,   // z
        0.3 + 0.5*Math.abs(Math.sin(u+v)),  // r
        0.5 + 0.3*Math.abs(Math.cos(v)),    // g
        0.8 - 0.3*t                          // b
      );
    }
  }
  for (let i = 0; i < radSeg; i++)
    for (let j = 0; j < tubeSeg; j++) {
      const a = i*(tubeSeg+1)+j, b = a+tubeSeg+1;
      indices.push(a, b, a+1,  b, b+1, a+1);
    }
  return { verts: new Float32Array(verts), indices: new Uint16Array(indices) };
}`,

  cylinder: `// Cylinder — side quad strip + top & bottom caps
function buildCylinder(slices=32) {
  const verts = [], indices = [];
  const H = 1.0, R = 0.5;
  // Side: two rings (bottom + top) interleaved
  for (let j = 0; j <= slices; j++) {
    const theta = 2 * Math.PI * j / slices;
    const ct = Math.cos(theta), st = Math.sin(theta);
    const t  = j / slices;
    verts.push(R*ct, -H/2, R*st,  0.2+0.4*t, 0.7, 0.9-0.4*t); // bottom
    verts.push(R*ct,  H/2, R*st,  0.3+0.4*t, 0.6, 1.0-0.4*t); // top
  }
  for (let j = 0; j < slices; j++) {
    const b = j*2;
    indices.push(b, b+2, b+1,  b+1, b+2, b+3);
  }
  // Caps: bottom (winding CW from below) + top (CCW from above)
  for (const [cy, sign] of [[-H/2, -1], [H/2, 1]]) {
    const capC = verts.length / 6;
    verts.push(0, cy, 0,  0.3, 0.6, 0.85);
    for (let j = 0; j <= slices; j++) {
      const theta = 2 * Math.PI * j / slices;
      verts.push(R*Math.cos(theta), cy, R*Math.sin(theta), 0.25,0.55,0.8);
    }
    for (let j = 0; j < slices; j++) {
      if (sign > 0) indices.push(capC, capC+j+1, capC+j+2);
      else          indices.push(capC, capC+j+2, capC+j+1);
    }
  }
  return { verts: new Float32Array(verts), indices: new Uint16Array(indices) };
}`
};

const SOURCE_VERT = `// WebGL Vertex Shader
// Transforms local-space vertex positions to clip space via MVP matrix.
// Passes per-vertex color through to fragment shader.
//
// Matches EasyMath C++ pipeline:
//   gl_Position = P * V * M * vec4(localPos, 1.0)
//
// Note: uMVP is passed as column-major (transposed from row-major C++ storage).

attribute vec3 aPos;     // local-space position
attribute vec3 aColor;   // per-vertex RGB color

uniform mat4 uMVP;       // Model × View × Projection (pre-multiplied)

varying vec3 vColor;     // pass color to fragment shader

void main() {
  gl_Position = uMVP * vec4(aPos, 1.0);
  vColor = aColor;
}`;

const SOURCE_FRAG = `// WebGL Fragment Shader
// Outputs interpolated vertex color as the final pixel color.
// Barycentric interpolation is handled automatically by the GPU.

precision mediump float;

varying vec3 vColor;  // interpolated from vertex shader

void main() {
  gl_FragColor = vec4(vColor, 1.0);  // RGB + full opacity
}`;

const SRC_MAP = { geo: null, vert: SOURCE_VERT, frag: SOURCE_FRAG };
let currentModalTab = 'geo';

function highlightCode(code) {
  return code
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/(\/\/[^\n]*)/g, '<span class="cm">$1</span>')
    .replace(/\b(function|const|let|var|for|if|else|return|new|of|in)\b/g, '<span class="kw">$1</span>')
    .replace(/\b(Float32Array|Uint16Array|Math\.PI|Math\.sin|Math\.cos|Math\.abs|Math\.sqrt)\b/g, '<span class="fn">$1</span>')
    .replace(/\b(-?\d+\.?\d*)\b/g, '<span class="nm">$1</span>');
}

function openModal() {
  SRC_MAP.geo = SOURCE_GEO[currentShape];
  const modal = document.getElementById('src-modal');
  const title = document.getElementById('modal-title');
  const names = { cube:'Cube', sphere:'Sphere', cone:'Cone', torus:'Torus', cylinder:'Cylinder' };
  title.textContent = (names[currentShape] || currentShape) + ' — Source Code';
  modal.classList.add('visible');
  showModalTab(currentModalTab);
}

function showModalTab(tab) {
  currentModalTab = tab;
  document.querySelectorAll('.modal-tab').forEach(b => b.classList.toggle('active', b.dataset.src === tab));
  const code = SRC_MAP[tab] || '';
  document.querySelector('#modal-code code').innerHTML = highlightCode(code);
}

document.getElementById('view-src-btn').addEventListener('click', openModal);

document.getElementById('modal-close-btn').addEventListener('click', () => {
  document.getElementById('src-modal').classList.remove('visible');
});

document.getElementById('src-modal').addEventListener('click', e => {
  if(e.target === document.getElementById('src-modal'))
    document.getElementById('src-modal').classList.remove('visible');
});

document.querySelectorAll('.modal-tab').forEach(btn => {
  btn.addEventListener('click', () => showModalTab(btn.dataset.src));
});

document.getElementById('modal-copy-btn').addEventListener('click', () => {
  const code = SRC_MAP[currentModalTab] || '';
  navigator.clipboard.writeText(code).then(() => {
    const btn = document.getElementById('modal-copy-btn');
    btn.textContent = '✓ Copied';
    btn.classList.add('copied');
    setTimeout(() => { btn.textContent = '⎘ Copy'; btn.classList.remove('copied'); }, 2000);
  }).catch(() => {});
});

// Close on Escape
document.addEventListener('keydown', e => {
  if(e.key === 'Escape') document.getElementById('src-modal').classList.remove('visible');
});

// Update modal title when shape changes
window.addEventListener('easymath:shapechange', () => {
  if(document.getElementById('src-modal').classList.contains('visible')) openModal();
});

// ============================================================
// SHAPE SELECTOR
// ============================================================
document.querySelectorAll('.shape-btn').forEach(btn => {
  if(btn.dataset.shape === currentShape) btn.classList.add('active');
  else btn.classList.remove('active');
  btn.addEventListener('click', () => {
    currentShape = btn.dataset.shape;
    STORAGE.set('shape', currentShape);
    document.querySelectorAll('.shape-btn').forEach(b => b.classList.toggle('active', b.dataset.shape === currentShape));
    window.dispatchEvent(new CustomEvent('easymath:shapechange', { detail: currentShape }));
  });
});

// ============================================================
// COLLAPSIBLE SECTIONS - persist state
// ============================================================
document.querySelectorAll('.cs[data-key]').forEach(details => {
  const key = 'section-' + details.dataset.key;
  const saved = STORAGE.get(key, null);
  if(saved === false) details.removeAttribute('open');
  details.addEventListener('toggle', () => STORAGE.set(key, details.open));
});

// ============================================================
// SLIDER UI SYNC
// ============================================================
document.querySelectorAll('input[type=range]').forEach(input => {
  const id = input.id;
  // Skip the orbit sensitivity slider — it has its own handler in the orbit
  // IIFE and shouldn't trigger matrix highlighting.
  if(id === 'orbit-sensitivity') return;
  const span = document.getElementById(id+'-v');
  if(!span) return;
  const isDeg = ['rx','ry','rz','fov'].includes(id);
  const isPrecise = ['ex','ey','ez','ltx','lty','ltz'].includes(id);
  const formatVal = v => isDeg ? v+'°' : isPrecise ? v.toFixed(2) : v.toFixed(1);
  const update = () => {
    const v = parseFloat(input.value);
    span.textContent = formatVal(v);

    // Gate cell-level highlights: only mark cells as "changed"
    // for the next 2 seconds. After that, default = no .hl.
    cellHighlightUntil = performance.now() + CELL_HIGHLIGHT_MS;

    // Trigger card-level matrix highlighting based on parameter
    highlightMatrixForParameter(id);

    // Auto-expire: dragging keeps resetting the timer (stays highlighted),
    // releasing lets it fire CELL_HIGHLIGHT_MS later. Shared with wheel/orbit.
    scheduleConnectorClear();
  };
  input.addEventListener('input', update);
  // Initialize display without highlighting
  const v = parseFloat(input.value);
  span.textContent = formatVal(v);
});

// ============================================================
// PARAMETER-MATRIX CORRELATION HIGHLIGHTING
// ============================================================
// Clear all highlights on page load (ensure no stale highlights)
document.querySelectorAll('.matrix-card').forEach(card => {
  card.classList.remove('highlight');
});
document.querySelectorAll('.matrix-arrow, .matrix-eq, .matrix-div').forEach(c => {
  c.classList.remove('active');
});

function highlightMatrixForParameter(paramId) {
  // Remove all existing highlights immediately
  document.querySelectorAll('.matrix-card').forEach(card => {
    card.classList.remove('highlight');
    // Force reflow to restart CSS animation
    void card.offsetWidth;
  });
  const connectors = document.querySelectorAll('.matrix-arrow, .matrix-eq, .matrix-div');
  connectors.forEach(c => {
    c.classList.remove('active');
    void c.offsetWidth;
  });

  // Determine which matrices to highlight based on parameter
  const matricesToHighlight = getMatricesForParameter(paramId);

  // Apply highlights (CSS will auto-fade after 2 seconds)
  matricesToHighlight.forEach(matrixName => {
    const card = document.querySelector(`.matrix-card[data-matrix="${matrixName}"]`);
    if (card) {
      card.classList.add('highlight');
    }
  });

  // Activate every connector whose data-from/data-to is an adjacent pair in the chain.
  // Chain can start at view or projection (not always model), so match by pair, not by index.
  if (matricesToHighlight.length >= 2) {
    for (let i = 0; i < matricesToHighlight.length - 1; i++) {
      const from = matricesToHighlight[i];
      const to   = matricesToHighlight[i + 1];
      connectors.forEach(c => {
        if (c.dataset.from === from && c.dataset.to === to) {
          c.classList.add('active');
        }
      });
    }
  }
}

function getMatricesForParameter(paramId) {
  // Translation, Rotation, Scale affect Model matrix
  const modelParams = ['tx', 'ty', 'tz', 'rx', 'ry', 'rz', 'sx', 'sy', 'sz'];
  // Camera parameters affect View matrix
  const viewParams = ['ex', 'ey', 'ez', 'ltx', 'lty', 'ltz'];
  // Projection parameters affect Projection matrix
  const projParams = ['fov', 'near', 'far', 'ortho-size'];
  // All matrices contribute to MVP
  const mvpParams = [...modelParams, ...viewParams, ...projParams];

  if (modelParams.includes(paramId)) {
    // Model changed: highlight Model → View → Projection → MVP chain
    return ['model', 'view', 'projection', 'mvp'];
  } else if (viewParams.includes(paramId)) {
    // View changed: highlight View → Projection → MVP chain
    return ['view', 'projection', 'mvp'];
  } else if (projParams.includes(paramId)) {
    // Projection changed: highlight Projection → MVP chain
    return ['projection', 'mvp'];
  } else {
    // Unknown parameter: highlight all
    return ['model', 'view', 'projection', 'mvp'];
  }
}
</script>
