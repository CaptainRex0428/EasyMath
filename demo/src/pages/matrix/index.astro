  document.getElementById('proj-mat-label').innerHTML =
    '<span class="sf">Camera</span><span class="sa"> →×' + matName + '→ </span><span class="st">Clip</span>';
}

// Apply saved projection mode on load
setProj(projMode);

// ============================================================
// ACTIVE TAB — declared early so renderers can read it
