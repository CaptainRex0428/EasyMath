let activeTab = (function() {
  const urlTab = new URLSearchParams(location.search).get('tab');
  if(urlTab === 'webgl' || urlTab === 'threejs') return urlTab;
  try { const v=localStorage.getItem('em-active-tab'); return (v==='"webgl"'||v==='"threejs"') ? JSON.parse(v) : 'webgl'; } catch(e){ return 'webgl'; }
