// SIDEBAR RESIZE
// ============================================================
(function initResize() {
  const MIN=200, MAX=600, DEFAULT=280;
  let savedWidth = STORAGE.get('sidebar-width', DEFAULT);
  savedWidth = Math.min(Math.max(savedWidth, MIN), MAX);

  function setWidth(w) {
    document.documentElement.style.setProperty('--sidebar-width', w + 'px');
  }
  setWidth(savedWidth);

  const resizer = document.getElementById('sidebar-resizer');
  let isResizing=false, startX=0, startW=0;

  resizer.addEventListener('mousedown', e => {
    isResizing=true; startX=e.clientX;
    startW = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--sidebar-width')) || DEFAULT;
    document.body.style.cursor='col-resize';
    document.body.style.userSelect='none';
    resizer.classList.add('resizing');
    e.preventDefault();
  });
  document.addEventListener('mousemove', e => {
    if(!isResizing) return;
    const w = Math.min(Math.max(startW + (e.clientX - startX), MIN), MAX);
    setWidth(w);
  });
  document.addEventListener('mouseup', () => {
    if(!isResizing) return;
    isResizing=false;
    document.body.style.cursor='';
    document.body.style.userSelect='';
    resizer.classList.remove('resizing');
    const w = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--sidebar-width')) || DEFAULT;
    STORAGE.set('sidebar-width', w);
  });
})();

// ============================================================
// MATRIX PANEL RESIZE
// ============================================================
(function initMatrixPanelResize() {
  const MIN=200, MAX=600, DEFAULT=280;
  const panel = document.getElementById('matrix-panel');
  const resizer = document.getElementById('matrix-resize-handle');
  const app = document.getElementById('app');

  let savedHeight = STORAGE.get('matrix-panel-height', DEFAULT);
  savedHeight = Math.min(Math.max(savedHeight, MIN), MAX);

  function setHeight(h) {
    app.style.gridTemplateRows = `var(--header-height) 1fr auto 6px ${h}px`;
  }
  setHeight(savedHeight);

  let isResizing=false, startY=0, startH=0;

  resizer.addEventListener('mousedown', e => {
    isResizing=true;
    startY=e.clientY;
    startH = panel.offsetHeight;
    document.body.style.cursor='ns-resize';
    document.body.style.userSelect='none';
    resizer.classList.add('dragging');
    e.preventDefault();
  });

  document.addEventListener('mousemove', e => {
    if(!isResizing) return;
    const deltaY = e.clientY - startY;
    const newH = Math.min(Math.max(startH - deltaY, MIN), MAX);
    setHeight(newH);
  });

  document.addEventListener('mouseup', () => {
    if(!isResizing) return;
    isResizing=false;
    document.body.style.cursor='';
    document.body.style.userSelect='';
    resizer.classList.remove('dragging');
    STORAGE.set('matrix-panel-height', panel.offsetHeight);
  });
})();

