---
/**
 * TabSwitcher.astro
 * Renders the WebGL / Three.js tab switcher buttons.
 * State is managed in client-side JS via storage and URL params.
 */
---
<div class="tab-switcher" role="tablist" aria-label="Rendering engine">
  <button class="tab-btn" role="tab" data-tab="webgl" aria-selected="false" id="tab-webgl">
    <span class="tab-icon">⚡</span>
    <span class="tab-label">Pure WebGL</span>
  </button>
  <button class="tab-btn" role="tab" data-tab="threejs" aria-selected="false" id="tab-threejs">
    <span class="tab-icon">🎲</span>
    <span class="tab-label">Three.js</span>
  </button>
</div>

<style>
  .tab-switcher {
    display: inline-flex;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 3px;
    gap: 2px;
  }

  .tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border: none;
    background: transparent;
    color: var(--text-secondary);
    font-size: 0.78rem;
    font-weight: 500;
    border-radius: 4px;
    cursor: pointer;
    transition: all var(--transition-fast);
    font-family: inherit;
  }

  .tab-btn:hover {
    color: var(--text-primary);
    background: var(--bg-tertiary);
  }

  .tab-btn.active {
    background: var(--bg-tertiary);
    color: var(--accent-blue);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
  }

  .tab-icon {
    font-size: 0.9rem;
    line-height: 1;
  }

  @media (max-width: 480px) {
    .tab-label {
      display: none;
    }
    .tab-btn {
      padding: 6px 10px;
    }
  }
</style>